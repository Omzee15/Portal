# Signs the per-game attempt cookies (dev stand-in for the attempts table).
# Generate one with: openssl rand -base64 32
LETTERBOX_COOKIE_SECRET=

# Where the Fuse party server lives. Local dev default is below.
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Public URL, used for share previews and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the Privacy and Terms pages. Required for a public launch: India's IT Rules and DPDP Act need a
# published contact for complaints and data requests. Use an address you are happy to publish.
NEXT_PUBLIC_CONTACT_EMAIL=

# Name of the grievance officer (usually you), shown on the Privacy and Terms pages.
NEXT_PUBLIC_GRIEVANCE_OFFICER=

# Set to 1 only for load tests: turns the API rate limiter off.
RATE_LIMIT_DISABLED=
