# Signs the per-game attempt cookies (dev stand-in for the attempts table).
# Generate one with: openssl rand -base64 32
LETTERBOX_COOKIE_SECRET=

# Where the Fuse party server lives. Local dev default is below.
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Public URL, used for share previews and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the Privacy and Terms pages. Optional; use an address you are happy to publish.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to 1 only for load tests: turns the API rate limiter off.
RATE_LIMIT_DISABLED=
